# syntax=docker/dockerfile:1
# Production image for Railway. The repo's ./Dockerfile is the dev image and is
# intentionally NOT used here.
FROM node:20-alpine AS build
WORKDIR /app
ENV ADAPTER=node
# Install with the workspace (packages/*) present so the `octothorpes` workspace
# package resolves.
COPY package.json package-lock.json ./
COPY packages ./packages
RUN npm ci
COPY . .
RUN npm run build

FROM node:20-alpine AS runtime
WORKDIR /app
ENV NODE_ENV=production
ENV ADAPTER=node
# adapter-node externalizes dependencies, so the runtime needs node_modules.
# Copy the full tree (incl. the octothorpes workspace symlink and its target)
# rather than a pruned prod install, so the symlink resolves.
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/packages ./packages
COPY --from=build /app/build ./build
COPY --from=build /app/package.json ./package.json
# #217 wave 3: site publishers are plain-ESM modules walked from disk at runtime
# at the path the profile declares (api.publishers.dir = "./static/publishers",
# resolved against the server CWD, which is /app here as in the repo root during
# dev). SvelteKit copies static/ verbatim into build/client, so the built tree is
# the source of truth; place it where the declared pointer resolves.
COPY --from=build /app/build/client/publishers ./static/publishers
# #217 wave 5: site handlers are the same pattern (plain-ESM modules walked
# from disk at api.handlers.dir = "./static/handlers"). Empty at present
# (only .gitkeep) — Task 21+ adds the first real handler.
COPY --from=build /app/build/client/handlers ./static/handlers
# #217 wave 5: site harmonizers are JSON data walked from disk at
# api.harmonizers.dir = "./static/harmonizers". Empty at present (only
# .gitkeep) — Tasks 22/23 add the first real harmonizer definitions.
COPY --from=build /app/build/client/harmonizers ./static/harmonizers
EXPOSE 3000
CMD ["node", "build"]
