# syntax=docker/dockerfile:1
# Production image for Railway. The repo's ./Dockerfile is the dev image and is
# intentionally NOT used here.
FROM node:20-alpine AS build
WORKDIR /app
ENV ADAPTER=node
# Install with the workspace (packages/*) present so the `octothorpes` workspace
# package resolves.
COPY package.json package-lock.json ./
COPY packages ./packages
RUN npm ci
COPY . .
RUN npm run build

FROM node:20-alpine AS runtime
WORKDIR /app
ENV NODE_ENV=production
ENV ADAPTER=node
# adapter-node externalizes dependencies, so the runtime needs node_modules.
# Copy the full tree (incl. the octothorpes workspace symlink and its target)
# rather than a pruned prod install, so the symlink resolves.
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/packages ./packages
COPY --from=build /app/build ./build
COPY --from=build /app/package.json ./package.json
# #217 wave 5 final review: site publishers/handlers/harmonizers are all
# walked from disk at runtime at paths the profile declares (api.*.dir =
# "./static/<kind>"), resolved against the server CWD (/app here, the repo
# root during dev). But those declared dirs aren't the only module-scope fs
# reads against static/ — e.g. src/routes/badge/+server.js readFileSync's
# static/badge.png at import time, and future features (path-form blocklists,
# etc.) will keep adding more. Copying only the three declared dirs is brittle
# (silently ENOENTs on anything not enumerated here, and COPY of a dir that's
# still empty/gitkeep-only can behave oddly across builders). SvelteKit copies
# static/ verbatim into build/client, so the built tree is the complete source
# of truth — ship all of it in one shot and every module-scope fs read against
# static/ just resolves, present or future.
COPY --from=build /app/build/client/ ./static/
EXPOSE 3000
CMD ["node", "build"]
