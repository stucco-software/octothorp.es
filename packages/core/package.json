{
  "name": "octothorpes",
  "version": "0.4.1",
  "type": "module",
  "description": "Core library for the Octothorpes Protocol",
  "main": "client.js",
  "bin": {
    "octothorpes": "./bin/octothorpes.js"
  },
  "exports": {
    ".": "./client.js",
    "./profile.schema.json": "./profile.schema.json",
    "./handlers/*": "./handlers/*"
  },
  "files": [
    "*.js",
    "ld/",
    "handlers/",
    "bin/",
    "profile.schema.json"
  ],
  "dependencies": {
    "ajv": "^6.15.0",
    "fast-xml-parser": "^5.8.0",
    "js-yaml": "^4.1.0",
    "jsdom": "^24.0.0",
    "jsonld": "^8.3.2",
    "normalize-url": "^8.0.1"
  },
  "peerDependencies": {},
  "license": "MIT"
}
