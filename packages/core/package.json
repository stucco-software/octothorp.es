{
  "name": "octothorpes",
  "version": "0.6.7",
  "type": "module",
  "description": "Core library for the Octothorpes Protocol",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stucco-software/octothorp.es.git",
    "directory": "packages/core"
  },
  "homepage": "https://docs.octothorp.es",
  "bugs": "https://github.com/stucco-software/octothorp.es/issues",
  "main": "client.js",
  "bin": {
    "octothorpes": "./bin/octothorpes.js"
  },
  "exports": {
    ".": "./client.js",
    "./profile.schema.json": "./profile.schema.json",
    "./harmonizer.schema.json": "./harmonizer.schema.json",
    "./handlers/*": "./handlers/*"
  },
  "files": [
    "*.js",
    "ld/",
    "handlers/",
    "harmonizers/",
    "publishers/",
    "bin/",
    "profile.schema.json",
    "harmonizer.schema.json",
    "CHANGELOG.md"
  ],
  "dependencies": {
    "ajv": "^6.15.0",
    "fast-xml-parser": "^5.8.0",
    "js-yaml": "^4.1.0",
    "jsdom": "^24.0.0",
    "jsonld": "^8.3.2",
    "normalize-url": "^8.0.1"
  },
  "peerDependencies": {},
  "license": "MIT"
}
