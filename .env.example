# Secrets and the one deploy-level override (identity.instance). Everything
# else that used to live here (server_name, badge_image, admin_email,
# default_handler) is now authored in octothorpes.json -- see identity.name,
# policies.access.badge, identity.contact.email, api.handlers.default.
sparql_endpoint=http://0.0.0.0:7878
sparql_user=user
sparql_password=password
instance=http://localhost:5173/
# Optional: load a different authored profile instead of ./octothorpes.json
# (path relative to the project root). Unset in normal deploys.
# The Bear relay deploy sets it to the Bear Blog profile:
#OP_PROFILE=profiles/bearblog/octothorpes.json
# What the client-endorsed endorsement source looks for in a page (on the Bear
# relay deploy, the marker Bear stamps its sites with). SECRET -- never commit a
# value. Unset: the source declines everything (and octothorp.es's own profile
# never consults it anyway). Two forms:
#   plain string: a <meta> whose content equals it
#     secret_knock=some-marker
#   JSON object with a type; today only "selector" (any element matching the
#   CSS selector). Leave simple attribute values unquoted; a value that needs
#   quotes takes JSON-escaped double quotes inside a single-quoted line:
#     secret_knock={"type":"selector","selector":"meta[name=octothorpes][content=some-marker]"}
#     secret_knock='{"type":"selector","selector":"meta[content=\"has space\"]"}'
#secret_knock=
fastmail_password=coolpassword

smtp_host=smtp.fastmail.com
smtp_port=587
smtp_secure=false
smtp_user=hello@nikolas.ws
smtp_password=coolpassword
robot_email=robot@octothorp.es
