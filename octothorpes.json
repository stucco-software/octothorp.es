{
  "$schema": "./packages/core/profile.schema.json",

  "identity": {
    "instance": "https://octothorp.es/",
    "name": "Octothorpes",
    "description": "The Octothorpes Protocol relay and reference client.",
    "terms": "https://octothorp.es/~/",
    "feeds": {
      "thorpes": ["octothorpe-news", "cats"],
      "multipass": "https://octothorp.es/news-and-favs.json"
    },
    "images": {
      "favicon": "/favicon.ico",
      "avatar": "/avatar.png"
    },
    "contact": {
      "email": "admin@octothorp.es",
      "bluesky": "@octothorp.es"
    }
  },

  "policies": {
    "commercial": false,
    "indexing": {
      "mode": "request",
      "frequency": "hourly"
    },
    "access": {
      "registration": "registered",
      "badge": "/badge.png",
      "blocks": {
        "domains": ["example.com"],
        "terms": []
      },
      "whitelist": {
        "domains": []
      }
    }
  },

  "api": {
    "linkTypes": [],
    "documentRecord": [],
    "publishers": {
      "dir": "./static/publishers"
    },
    "handlers": {
      "dir": "./static/handlers",
      "default": "html"
    },
    "harmonizers": {
      "dir": "./src/lib/harmonizers"
    }
  },

  "vocabulary": {
    "namespaces": [
      { "prefix": "skos", "iri": "http://www.w3.org/2004/02/skos/core#", "import": true }
    ]
  }
}
