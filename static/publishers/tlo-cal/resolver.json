{
  "context": "https://tinylittleoffice.com/",
  "id": "https://octothorp.es/publishers/tlo-cal",
  "type": "resolver",
  "contentType": "application/json",
  "meta": {
    "name": "TLO Calendar",
    "description": "Publishes the result set as one Tiny Little Office calendar link, one event per page dated by postDate"
  },
  "envelope": {
    "title": "Octothorpes Calendar"
  },
  "schema": {
    "url": { "from": "@id", "required": true },
    "title": { "from": ["title", "@id"], "required": true },
    "date": { "from": "postDate", "postProcess": { "method": "date", "params": "iso8601" }, "required": true }
  }
}
